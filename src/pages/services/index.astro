---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ServicePriceList from "../../components/ServicePriceList.astro";
import ServicesGrid from "../../components/ServicesGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Главная", item: "https://denisyuce.com/" },
  { "@type": "ListItem", position: 2, name: "Услуги", item: "https://denisyuce.com/services/" },
] };
---

<BaseLayout title="Услуги и цены — массаж в Крылатском" description="Услуги и цены на массаж в Крылатском: классический, расслабляющий, спортивный, лимфодренажный массаж, массаж лица и массаж спины, плеч и шеи." canonical="https://denisyuce.com/services/" breadcrumbSchema={breadcrumb}>
  <main class="page service-page">
    <Header />
    <section class="section services-title">
      <div class="breadcrumbs"><a href="/">Главная</a></div>
      <div class="section-head"><h1>Услуги и цены</h1></div>
      <p class="services-title-lead">Массаж в Крылатском: классический, расслабляющий, спортивный, лимфодренажный, массаж лица и работа с зонами напряжения.</p>
    </section>
    <section class="section service-list-page services-content"><ServicesGrid /></section>
    <section class="section service-price-section" id="prices"><ServicePriceList /></section>
    <Footer />
  </main>
</BaseLayout>
