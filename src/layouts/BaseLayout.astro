---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  bodyClass?: string;
  schema?: unknown | unknown[];
  breadcrumbSchema?: unknown;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  bodyClass,
  schema,
  breadcrumbSchema,
  ogImage = "https://denisyuce.com/assets/og/denis-massage-krylatskoe.jpg",
  ogImageAlt = "Денис Пучков — массаж в Крылатском",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0d0f12" />
    <meta name="geo.region" content="RU-MOW" />
    <meta name="geo.placename" content="Москва, Крылатское" />
    <meta name="geo.position" content="55.749238;37.419761" />
    <meta name="ICBM" content="55.749238, 37.419761" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Денис Пучков" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1792" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="yandex-verification" content="9c7df97d658c1f2a" />
    <meta name="p:domain_verify" content="d2809a622808774a00abbd86d6f352e6" />
    <link rel="stylesheet" href="/assets/site.css" />
    <script src="/assets/site.js" defer></script>
    {schema && <script type="application/ld+json" data-seo-schema set:html={JSON.stringify(schema)} />}
    {breadcrumbSchema && <script type="application/ld+json" data-breadcrumb-schema set:html={JSON.stringify(breadcrumbSchema)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
